		<title>Why Deploying Physical AI at Scale Demands Safety at Every Layer</title>
		<link>https://blogs.nvidia.com/blog/physical-ai-halos-safety/</link>
		
		<dc:creator><![CDATA[Riccardo Mariani]]></dc:creator>
		<pubDate>Mon, 21 Sep 2026 16:00:46 +0000</pubDate>
