		<title>Skild AI Taps NVIDIA Physical AI to Teach Robots New Tasks From a Single Video</title>
		<link>https://blogs.nvidia.com/blog/skild-ai-s1-physical-ai/</link>
		
		<dc:creator><![CDATA[Sasa Docca]]></dc:creator>
		<pubDate>Thu, 10 Sep 2026 16:30:35 +0000</pubDate>
