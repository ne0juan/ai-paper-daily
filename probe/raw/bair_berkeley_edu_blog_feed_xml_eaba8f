(function () {
  var root = document.getElementById(&apos;abbel-frames&apos;);
  if (!root) return;
  var count = parseInt(root.getAttribute(&apos;data-frame-count&apos;) || &apos;15&apos;, 10);
  var prefix = root.getAttribute(&apos;data-frame-prefix&apos;) || &apos;https://bair.berkeley.edu/static/blog/abbel/frames/frame_&apos;;
  var intervalMs = parseInt(root.getAttribute(&apos;data-interval&apos;) || &apos;1300&apos;, 10);
  var img = document.getElementById(&apos;abbel-frames-img&apos;);
  var meta = document.getElementById(&apos;abbel-frames-meta&apos;);
  var dots = document.getElementById(&apos;abbel-frames-dots&apos;);
  var btnPrev = document.getElementById(&apos;abbel-frames-prev&apos;);
  var btnNext = document.getElementById(&apos;abbel-frames-next&apos;);
  var btnPlay = document.getElementById(&apos;abbel-frames-play&apos;);
  var stage = root.querySelector(&apos;.abbel-frames__stage&apos;);
  var hint = root.querySelector(&apos;.abbel-frames__hint&apos;);
  var i = 0;
  var playing = false;
  var timer = null;
  var urls = [];
  for (var n = 0; n &lt; count; n++) {
    urls.push(prefix + (n &lt; 10 ? &apos;0&apos; + n : &apos;&apos; + n) + &apos;.png&apos;);
  }
  urls.forEach(function (u) { var im = new Image(); im.src = u; });
  if (dots) {
    for (var d = 0; d &lt; count; d++) {
      (function (idx) {
        var b = document.createElement(&apos;button&apos;);
        b.type = &apos;button&apos;;
        b.setAttribute(&apos;aria-label&apos;, &apos;Go to frame &apos; + (idx + 1));
        b.addEventListener(&apos;click&apos;, function (e) {
          e.stopPropagation();
          stop();
          show(idx);
        });
        dots.appendChild(b);
      })(d);
    }
  }
  function setHint(text) {
    if (hint) hint.textContent = text;
  }
  function show(idx) {
    i = (idx + count) % count;
    img.src = urls[i];
    if (meta) meta.textContent = (i + 1) + &apos; / &apos; + count;
    if (dots) {
      var kids = dots.children;
      for (var k = 0; k &lt; kids.length; k++) {
        if (k === i) kids[k].setAttribute(&apos;aria-current&apos;, &apos;true&apos;);
        else kids[k].removeAttribute(&apos;aria-current&apos;);
      }
    }
  }
  function stop() {
    playing = false;
    if (timer) { clearInterval(timer); timer = null; }
    root.classList.remove(&apos;is-playing&apos;);
    root.classList.add(&apos;is-paused&apos;);
    if (btnPlay) {
      btnPlay.textContent = &apos;Play&apos;;
      btnPlay.setAttribute(&apos;aria-pressed&apos;, &apos;false&apos;);
    }
    //setHint(&apos;Click to advance&apos;); not pretty text, and functionality is clear already
  }
  function start() {
    playing = true;
    root.classList.add(&apos;is-playing&apos;);
    root.classList.remove(&apos;is-paused&apos;);
    if (btnPlay) {
      btnPlay.textContent = &apos;Pause&apos;;
      btnPlay.setAttribute(&apos;aria-pressed&apos;, &apos;true&apos;);
    }
    //setHint(&apos;Click to pause&apos;);
    if (timer) clearInterval(timer);
    timer = setInterval(function () { show(i + 1); }, intervalMs);
  }
  function advance() {
    if (playing) { stop(); return; }
    stop();
    show(i + 1);
  }
  function back() { stop(); show(i - 1); }
  if (stage) {
    stage.addEventListener(&apos;click&apos;, advance);
    stage.addEventListener(&apos;keydown&apos;, function (e) {
      if (e.key === &apos;Enter&apos; || e.key === &apos; &apos;) { e.preventDefault(); advance(); }
      if (e.key === &apos;ArrowRight&apos;) { e.preventDefault(); advance(); }
      if (e.key === &apos;ArrowLeft&apos;) { e.preventDefault(); back(); }
    });
  }
  if (btnNext) btnNext.addEventListener(&apos;click&apos;, function () { stop(); show(i + 1); });
  if (btnPrev) btnPrev.addEventListener(&apos;click&apos;, back);
  if (btnPlay) btnPlay.addEventListener(&apos;click&apos;, function () {
    if (playing) stop(); else start();
  });
  show(0);
  // Autoplay like a GIF: start once the first frame is ready, and again when scrolled into view
  function kickoff() {
    if (!playing) start();
  }
  if (img.complete) kickoff();
  else img.addEventListener(&apos;load&apos;, kickoff, { once: true });
  if (&apos;IntersectionObserver&apos; in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) kickoff();
      });
    }, { threshold: 0.35 });
    io.observe(root);
  }
})();
&lt;/script&gt;

