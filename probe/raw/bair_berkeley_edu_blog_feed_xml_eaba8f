        <title>2026 BAIR Graduate Showcase</title>
        <description>&lt;!-- twitter --&gt;
&lt;meta name=&quot;twitter:title&quot; content=&quot;2026 BAIR Graduate Showcase&quot; /&gt;

&lt;meta name=&quot;twitter:card&quot; content=&quot;summary_large_image&quot; /&gt;

&lt;meta name=&quot;keywords&quot; content=&quot;graduates, celebration, showcase&quot; /&gt;

&lt;meta name=&quot;description&quot; content=&quot;The BAIR Blog&quot; /&gt;

