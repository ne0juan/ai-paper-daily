		<title>Microsoft expands Azure AI and HPC infrastructure with AMD</title>
		<link>https://blogs.microsoft.com/blog/2026/07/20/microsoft-expands-azure-ai-and-hpc-infrastructure-with-amd/</link>
		
		<dc:creator><![CDATA[Scott Guthrie]]></dc:creator>
		<pubDate>Mon, 20 Jul 2026 13:00:02 +0000</pubDate>
				<category><![CDATA[Featured]]></category>
