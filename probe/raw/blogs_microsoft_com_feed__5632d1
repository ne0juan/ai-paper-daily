		<item>
		<title>Rethinking security for the age of AI</title>
		<link>https://blogs.microsoft.com/blog/2026/07/27/rethinking-security-for-the-age-of-ai/</link>
		
		<dc:creator><![CDATA[Hayete Gallot]]></dc:creator>
		<pubDate>Mon, 27 Jul 2026 16:30:09 +0000</pubDate>
				<category><![CDATA[Featured]]></category>
