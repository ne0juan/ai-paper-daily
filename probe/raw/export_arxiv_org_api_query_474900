    <title>WorldCrafter: Consistent Video World Model with Implicit 3D-aware Memory</title>
    <updated>2026-09-21T17:57:06Z</updated>
    <link href="https://arxiv.org/abs/2609.24984v1" rel="alternate" type="text/html"/>
