    <title>Rethinking Length-Based Training: Batch Composition and Loss Normalization in Speech Token Language Models</title>
    <updated>2026-09-22T08:56:01Z</updated>
    <link href="https://arxiv.org/abs/2609.25890v1" rel="alternate" type="text/html"/>
