<!-- FINISH GLOBAL SCRIPTS --><!-- FILTERS LOGIC (single-select) -->
<script>
  document.addEventListener('DOMContentLoaded', function () {
    console.log('[DEBUG] DOMContentLoaded fired');

    // --- Element references ---
    const viewAllLabel = document.querySelector('.blog-filetrs-col .v2-checkbox-field-blog-stroke:first-child .v2-checkbox-field-blog');
    const leftFilterLabels = document.querySelectorAll('.w-dyn-item .v2-checkbox-field-blog');
    const dropdownLabels = document.querySelectorAll('.blog-filter-checkbox-field');
    const counterEl = document.querySelector('.is-number');

    const featuredWrappers = document.querySelectorAll('.blog-list-wrapper.is-featured');
    const heroSections = document.querySelectorAll('.blog-hero-section');
    const spacerSections = document.querySelectorAll('.spacer-100.is-featured');

    const searchInput = document.querySelector('input[fs-list-field="title"]');
    const emptyEl = document.querySelector('[blog-element="empty"]');

    let isSyncing = false;

    // --- Helpers ---
    function getText(label) {
      return label.querySelector('span').textContent.trim();
    }

    function isChecked(label) {
      return label.querySelector('[class*="w-checkbox-input--inputType-custom"]').classList.contains('w--redirected-checked');
    }

    function setChecked(label, state) {
      const box = label.querySelector('[class*="w-checkbox-input--inputType-custom"]');
      const input = label.querySelector('input[type="checkbox"]');
      box.classList.toggle('w--redirected-checked', state);
      input.checked = state;
    }

    function triggerFinsweetClick(label) {
      const input = label.querySelector('input[type="checkbox"]');
      if (input) input.click();
    }

    function getDropdownByText(text) {
      return Array.from(dropdownLabels).find((l) => getText(l) === text);
    }

    function getLeftByText(text) {
      return Array.from(leftFilterLabels).find((l) => getText(l) === text);
    }

    // --- Count filters ---
    function getActiveCount() {
      const leftTexts = new Set(Array.from(leftFilterLabels).map(getText));
      const activeLeft = Array.from(leftFilterLabels).filter(isChecked).length;

      const activeDropdownOnly = Array.from(dropdownLabels).filter((l) => {
        const text = getText(l);
        return text !== 'All posts' && !leftTexts.has(text) && isChecked(l);
      }).length;

      return activeLeft + activeDropdownOnly;
    }

    function updateCounter() {
      const count = getActiveCount();
      counterEl.textContent = count;
      counterEl.style.display = count > 0 ? 'block' : 'none';
    }

    // --- Featured + hero hide/show logic ---
    function updateFeatured() {
      if (!featuredWrappers.length && !heroSections.length && !spacerSections.length) return;

      const hasActiveFilters = getActiveCount() > 0;
      const hasSearchQuery = searchInput && searchInput.value.trim() !== '';
      const shouldHide = hasActiveFilters || hasSearchQuery;

      console.log('[DEBUG] updateFeatured →', shouldHide);

      if (shouldHide) {
        featuredWrappers.forEach((el) => { el.style.display = 'none'; });
        heroSections.forEach((el) => { el.style.display = 'none'; });
        spacerSections.forEach((el) => { el.style.display = 'block'; });
      } else {
        featuredWrappers.forEach((el) => { el.style.display = ''; });
        heroSections.forEach((el) => { el.style.display = ''; });
        spacerSections.forEach((el) => { el.style.display = 'none'; });
      }
    }

    window.updateFeatured = updateFeatured;

    // --- Empty state ---
    window.updateEmptyState = function updateEmptyState() {
      if (!emptyEl) return;

      const blogList = document.querySelector('.blog-list.is-normal');
      if (!blogList) return;

      const allItems = blogList.querySelectorAll('.w-dyn-item');
      const visibleItems = Array.from(allItems).filter(
        (el) => getComputedStyle(el).display !== 'none'
      );

      const isEmpty = visibleItems.length === 0;
      emptyEl.style.display = isEmpty ? 'block' : 'none';

      const storiesEl = document.querySelector('[blog-element="stories"]');
      const recentEl = document.querySelector('[blog-element="recent"]');
      if (storiesEl) storiesEl.style.display = isEmpty ? 'none' : '';
      if (recentEl) recentEl.style.display = isEmpty ? 'none' : '';

      const newsletterEl = document.querySelector('[blog-element="newsletter"]');
      const emptyContainer = document.querySelector('[blog-element="empty-container"]');

      if (newsletterEl && emptyContainer) {
        if (isEmpty) {
          if (!newsletterEl._originalParent) {
            newsletterEl._originalParent = newsletterEl.parentElement;
            newsletterEl._originalNext = newsletterEl.nextElementSibling;
          }
          newsletterEl.style.marginTop = '4rem';
          emptyContainer.appendChild(newsletterEl);
        } else if (newsletterEl._originalParent) {
          newsletterEl.style.marginTop = '';
          if (newsletterEl._originalNext) {
            newsletterEl._originalParent.insertBefore(newsletterEl, newsletterEl._originalNext);
          } else {
            newsletterEl._originalParent.appendChild(newsletterEl);
          }
        }
      }

      if (typeof window.updateFeatured === 'function') {
        window.updateFeatured();
      }
    };

    function updateViewAll() {
      const anyActive = getActiveCount() > 0;
      setChecked(viewAllLabel, !anyActive);

      const allPostsLabel = getDropdownByText('All posts');
      if (allPostsLabel) setChecked(allPostsLabel, !anyActive);
    }

    function clearAllCategories() {
      leftFilterLabels.forEach((l) => setChecked(l, false));

      dropdownLabels.forEach((l) => {
        if (getText(l) === 'All posts') return;

        const input = l.querySelector('input[fs-list-value]');
        if (input && input.checked) {
          isSyncing = true;
          input.click();
          isSyncing = false;
        }

        setChecked(l, false);
      });
    }

    // --- NEW: clear everything except one category (single-select core) ---
    function clearOtherCategories(exceptText) {
      // Visually uncheck every left filter except the one we just selected
      leftFilterLabels.forEach((l) => {
        if (getText(l) !== exceptText) setChecked(l, false);
      });

      // Tell Finsweet to drop the previously-active dropdown filter(s)
      dropdownLabels.forEach((l) => {
        const text = getText(l);
        if (text === 'All posts' || text === exceptText) return;

        if (isChecked(l)) {
          const input = l.querySelector('input[fs-list-value]');
          if (input) {
            isSyncing = true;
            input.click();
            isSyncing = false;
          }
          setChecked(l, false);
        }
      });
    }

    function afterFilterChange(source) {
      console.log('[DEBUG] afterFilterChange:', source);
      updateViewAll();
      updateCounter();
      updateFeatured();

      setTimeout(() => {
        window.updateEmptyState();
      }, 400);
    }

    // --- Left filters (single-select) ---
    leftFilterLabels.forEach((label) => {
      label.addEventListener('click', () => {
        if (isSyncing) return;

        setTimeout(() => {
          const text = getText(label);
          const checked = isChecked(label);

          // If the user just turned this one ON, kill all others first
          if (checked) {
            clearOtherCategories(text);
          }

          const mirror = getDropdownByText(text);
          if (mirror) {
            setChecked(mirror, !checked);
            isSyncing = true;
            triggerFinsweetClick(mirror);
            isSyncing = false;
          }

          afterFilterChange('left: ' + text);
        }, 0);
      });
    });

    // --- View all ---
    viewAllLabel.addEventListener('click', () => {
      if (isSyncing) return;

      setTimeout(() => {
        if (isChecked(viewAllLabel)) {
          clearAllCategories();
          afterFilterChange('view-all');
        }
      }, 0);
    });

    // --- Dropdown (single-select) ---
    dropdownLabels.forEach((label) => {
      label.addEventListener('click', () => {
        if (isSyncing) return;

        setTimeout(() => {
          const text = getText(label);

          if (text === 'All posts') {
            clearAllCategories();
            afterFilterChange('dropdown-all');
            return;
          }

          const checked = isChecked(label);

          // If the user just turned this one ON, kill all others first
          if (checked) {
            clearOtherCategories(text);
          }

          const mirror = getLeftByText(text);
          if (mirror) setChecked(mirror, checked);

          afterFilterChange('dropdown: ' + text);
        }, 0);
      });
    });

    // --- Search ---
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        updateFeatured();
        setTimeout(() => {
          window.updateEmptyState();
        }, 400);
      });
    }

    // --- Init ---
    updateViewAll();
    updateCounter();
    updateFeatured();
    window.updateEmptyState();

    console.log('[DEBUG] Init complete');
  });

  // --- Pagination scroll ---
  const paginationWrapper = document.querySelector('.w-pagination-wrapper');

  if (paginationWrapper) {
    paginationWrapper.addEventListener('click', (e) => {
      const clicked = e.target.closest('.blog-pagination-el, .fs-page-button');
      if (!clicked) return;

      const blogSection = document.getElementById('blog');
      if (blogSection) {
        blogSection.scrollIntoView({ behavior: 'smooth' });
      }
    });
  }
</script>






