<!-- Finsweet FIX that you can use browser navigation when clicking on pagination -->
<script>
(function () {
  // Detect if a URL change is a Finsweet pagination change (key ends with _page)
  function isPaginationChange(newUrl) {
    try {
      const next = new URL(newUrl, window.location.href);
      const curr = new URL(window.location.href);
      const keys = new Set([
        ...next.searchParams.keys(),
        ...curr.searchParams.keys(),
      ]);
      for (const key of keys) {
        if (
          key.endsWith('_page') &&
          next.searchParams.get(key) !== curr.searchParams.get(key)
        ) {
          return true;
        }
      }
      return false;
    } catch (e) {
      return false;
    }
  }

  // Turn pagination replaceState calls into pushState so they go into browser history
  const originalReplaceState = history.replaceState.bind(history);
  history.replaceState = function (state, title, url) {
    if (url && isPaginationChange(url)) {
      return history.pushState(state, title, url);
    }
    return originalReplaceState(state, title, url);
  };

  // When the user hits Back/Forward, reload so Webflow serves the correct page
  window.addEventListener('popstate', function () {
    window.location.reload();
  });
})();
