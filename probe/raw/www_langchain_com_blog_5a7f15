<script>
  // Names in this list are never shortened
  const AUTHOR_NAME_EXCEPTIONS = ['LangChain Labs'];

  function formatAuthorNames() {
    document.querySelectorAll('.blog-author-name-list:not([data-formatted])').forEach((list) => {
      const items = list.querySelectorAll('.blog-author-name-item');
      list.setAttribute('data-formatted', 'true');
      if (items.length <= 1) return;
      items.forEach((item, index) => {
        const el = item.querySelector('[class*="t-paragraph"]');
        if (!el) return;
        const fullName = el.textContent.trim();
        const words = fullName.split(' ');
        if (words.length >= 2 && !AUTHOR_NAME_EXCEPTIONS.includes(fullName)) {
          words[0] = words[0][0] + '.';
          el.textContent = words.join(' ');
        } else {
          el.textContent = fullName;
        }
        if (index < items.length - 1) {
          el.textContent += ',';
        }
      });
    });
  }
  // Initial run
  formatAuthorNames();
  // Catch any DOM swap (Finsweet pagination, Webflow re-render, etc.)
  let debounce;
  new MutationObserver(() => {
    clearTimeout(debounce);
    debounce = setTimeout(formatAuthorNames, 50);
  }).observe(document.body, { childList: true, subtree: true });
  // Belt-and-suspenders: also re-run on pagination clicks with staggered retries
  // in case the mutation observer misses the swap timing
  document.addEventListener('click', (e) => {
    if (e.target.closest('.w-pagination-wrapper, [fs-list-element="page-button"]')) {
      [100, 300, 600, 1000].forEach((ms) => setTimeout(formatAuthorNames, ms));
    }
  });
</script>

<!-- Add classes for first blog post in featured -->
<script>
  function applyFeaturedFirst() {
    // Target only the list inside the featured wrapper
    const featuredList = document.querySelector('.blog-list-wrapper.is-featured .blog-list.is-featured');
    if (!featuredList) return;
    const firstItem = featuredList.querySelector('.blog-item:first-child');
    if (!firstItem) return;
    const selectors = ['.blog-link', '.blog-thumbnail', '.blog-card-wrapper-stroke', '.blog-card-wrapper', '.blog-author-img', '.t-label-2-rg.date-color', '.t-heading-6-rg.text-c-blue-light-900', '.blog-categories-label.t-label-2-rg'];
    const isDesktop = window.innerWidth >= 992;
    selectors.forEach((selector) => {
      firstItem.querySelectorAll(selector).forEach((el) => {
        el.classList.toggle('is-first', isDesktop);
      });
    });
  }

  function applyBlogStyles() {
    applyFeaturedFirst();
  }

  applyBlogStyles();
  window.addEventListener('resize', applyBlogStyles);
</script></div></main><footer dark-bg="" class="v2-footer"><div class="v2-padding-global"><div class="w-layout-blockcontainer v2-container w-container"><div class="v2-footer-wrapper"><div class="v2-footer-grid"><div class="v2-footer-col"><div class="v2-footer-divider"></div><h6 class="t-heading-6-rg text-c-blue-light-900">Products</h6><div class="v2-footer-links"><a data-wf-native-id-path="e1149084-cbc6-fb0b-8d2a-7647f6213539:08562405-8b11-48b6-ab5d-f3b7e924ef82" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="08562405-8b11-48b6-ab5d-f3b7e924ef82" data-wf-component-context="%5B%7B%22componentId%22%3A%2208562405-8b11-48b6-ab5d-f3b7e924ef74%22%2C%22instanceId%22%3A%22e1149084-cbc6-fb0b-8d2a-7647f6213539%22%7D%5D" href="/langsmith-platform" class="v2-footer-link t-label-1-rg">LangSmith Platform</a><a data-wf-native-id-path="e1149084-cbc6-fb0b-8d2a-7647f6213539:6587bd1f-3132-1119-0097-31194a71ee3e" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="6587bd1f-3132-1119-0097-31194a71ee3e" data-wf-component-context="%5B%7B%22componentId%22%3A%2208562405-8b11-48b6-ab5d-f3b7e924ef74%22%2C%22instanceId%22%3A%22e1149084-cbc6-fb0b-8d2a-7647f6213539%22%7D%5D" href="/langsmith/observability" class="v2-footer-link t-label-1-rg">LangSmith Observability</a><a data-wf-native-id-path="e1149084-cbc6-fb0b-8d2a-7647f6213539:08562405-8b11-48b6-ab5d-f3b7e924ef84" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="08562405-8b11-48b6-ab5d-f3b7e924ef84" data-wf-component-context="%5B%7B%22componentId%22%3A%2208562405-8b11-48b6-ab5d-f3b7e924ef74%22%2C%22instanceId%22%3A%22e1149084-cbc6-fb0b-8d2a-7647f6213539%22%7D%5D" href="/langsmith/evaluation" class="v2-footer-link t-label-1-rg">LangSmith Evaluation</a><a data-wf-native-id-path="e1149084-cbc6-fb0b-8d2a-7647f6213539:08562405-8b11-48b6-ab5d-f3b7e924ef86" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="08562405-8b11-48b6-ab5d-f3b7e924ef86" data-wf-component-context="%5B%7B%22componentId%